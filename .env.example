# Global Environment Settings

# Environment Mode: development | staging | production
NODE_ENV=development
ENVIRONMENT=development

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=flightsense
DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/flightsense

# Machine Learning / Model Paths
MODEL_PATH=models/xgboost_flight_delay_latest.joblib
ENCODER_PATH=models/feature_encoders_latest.joblib
SCALER_PATH=models/feature_scaler_latest.joblib
EXPLAINER_PATH=models/shap_explainer_latest.joblib

# Security & Secrets
SECRET_KEY=super-secret-key-change-in-production-32-bytes-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
