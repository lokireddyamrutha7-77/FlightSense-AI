# FastAPI Backend Settings
PROJECT_NAME="FlightSense AI API"
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database (MySQL)
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="your_mysql_password_here"
DB_NAME="flightsense"
DATABASE_URL="mysql+pymysql://root:your_mysql_password_here@localhost:3306/flightsense"

# Model Paths
MODEL_PATH="../models/xgboost_flight_delay_latest.joblib"
PREPROCESSOR_PATH="../models/preprocessor_latest.joblib"
